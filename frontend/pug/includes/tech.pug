-
	// картинки/иконки шагов общие, тексты — из словаря
	var STEPS = [
		{ icon: 'core', img: 'step-core', w: 1280, h: 720 },
		{ icon: 'route', img: 'step-routing', w: 1280, h: 720 },
		{ icon: 'satellite', img: 'step-relay', w: 1600, h: 900 },
		{ icon: 'fiber', img: 'step-fiber', w: 1600, h: 900 },
		{ icon: 'home', img: 'step-home', w: 1280, h: 720 }
	].map(function (s, i) {
		var t = T.tech.steps[i];
		s.title = t.title;
		s.text = t.text;
		s.specs = t.specs;
		return s;
	});

//- Пин: секция прилипает, шаги едут горизонтально
section.tech#technology(aria-labelledby='tech-title' data-tech)
	.tech__inner
		.container.tech__head
			div
				p.label(data-scramble)= T.tech.label
				h2.title#tech-title(data-type)
					= T.tech.t1
					br
					span.grad= T.tech.t2
			.tech__meta
				p.text(data-fade)= T.tech.text
				.tech__progress(data-fade aria-hidden='true')
					span.tech__count
						span(data-tech-index) 01
						|  / 05
					span.tech__bar
						span(data-tech-bar)
		.tech__track(data-tech-track)
			each s, i in STEPS
				article.step(data-step)
					.step__media
						img(src=ROOT + 'public/img/' + s.img + '.webp' alt='' width=s.w height=s.h loading='lazy' decoding='async' data-step-img)
						span.step__tag(aria-hidden='true')= T.tech.hop + ' 0' + (i + 1)
					.step__body
						.step__head
							span.step__num(aria-hidden='true') 0#{i + 1}
							+ico(s.icon)
						h3.step__title= s.title
						p.step__text= s.text
						dl.step__specs
							each sp in s.specs
								div
									dt= sp[0]
									dd= sp[1]
