-
	// ЗАМЕНИТЬ на боевой домен (используется в canonical, hreflang, Open Graph, JSON-LD); robots.txt и sitemap.xml — там же
	var SITE = 'https://domain.example/';

	// версия кадров видео: МЕНЯТЬ при каждой перенарезке public/seq/* — иначе браузеры возьмут старые кадры из кэша
	// (имена файлов те же: 000.webp, 001.webp…) и смешают их с новыми
	var SEQ_V = '48fps-1';
	var PAGE_URL = SITE + PATH;

	var META = {
		title: T.meta.title,
		description: T.meta.description,
		image: SITE + 'public/img/og-image.jpg',
		imageAlt: T.meta.imageAlt
	};

	// тарифы: цены/иконки общие, тексты — из словаря
	var PLANS = [
		{ id: 'cosmic', code: 'PLAN / 01', type: 'cosmic', price: '59.99' },
		{ id: 'galactic', code: 'PLAN / 02', type: 'galactic', price: '89.99', featured: true },
		{ id: 'supernova', code: 'PLAN / 03', type: 'supernova', price: '159.99' }
	].map(function (p) {
		var t = T.plans.items[p.id];
		p.name = t.name;
		p.desc = t.desc;
		p.speed = t.speed;
		p.list = t.list;
		return p;
	});

	// структурированные данные для поисковиков
	var LD = {
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'Organization',
				'@id': SITE + '#organization',
				name: 'DOMAIN',
				url: SITE,
				logo: SITE + 'public/img/icon-512.png',
				slogan: T.meta.slogan,
				description: META.description
			},
			{
				'@type': 'WebSite',
				'@id': SITE + '#website',
				url: SITE,
				name: 'DOMAIN',
				inLanguage: LANG_ORDER,
				publisher: { '@id': SITE + '#organization' }
			},
			{
				'@type': 'Service',
				'@id': PAGE_URL + '#internet',
				serviceType: T.meta.service,
				name: 'DOMAIN Premium Internet',
				inLanguage: LANG,
				provider: { '@id': SITE + '#organization' },
				areaServed: 'Worldwide',
				hasOfferCatalog: {
					'@type': 'OfferCatalog',
					name: T.nav.plans,
					itemListElement: PLANS.map(function (p) {
						return {
							'@type': 'Offer',
							name: p.name,
							description: p.speed + '. ' + p.list.join(', ') + '.',
							url: PAGE_URL + '#plans',
							price: p.price,
							priceCurrency: 'USD',
							priceSpecification: { '@type': 'UnitPriceSpecification', price: p.price, priceCurrency: 'USD', unitText: 'MONTH' },
							itemOffered: { '@type': 'Service', name: 'DOMAIN ' + p.name + ' (' + p.speed + ')' }
						};
					})
				}
			}
		]
	};
