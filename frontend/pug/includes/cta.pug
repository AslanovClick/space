section.cta(aria-labelledby='cta-title' data-rest)
	.container
		.cta__box(data-cta)
			.cta__media
				img.cta__img(src=ROOT + 'public/img/cta-moon.webp' alt='' width='1920' height='1080' loading='lazy' decoding='async' data-cta-img)
			.cta__content
				p.label(data-scramble)= T.cta.label
				h2.title#cta-title(data-type)
					= T.cta.t1
					br
					span.grad= T.cta.t2
				p.text(data-fade)= T.cta.text
				.cta__actions(data-fade)
					a.btn.btn--primary(href='#plans' data-magnetic)
						span= T.cta.connect
						+icon('arrow')
					a.btn.btn--ghost(href='#' data-magnetic)
						span= T.cta.talk
						+icon('comms')
