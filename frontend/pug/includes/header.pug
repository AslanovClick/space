mixin langLinks(cls)
	each l in LANG_ORDER
		li
			a(class=cls href=langHref(l) hreflang=l lang=l aria-current=(l === LANG ? 'true' : false) data-lang-link=l)
				span(class=cls + '-code')= LANGS[l].code
				span(class=cls + '-name')= LANGS[l].name

header.header(data-header)
	.container.header__inner
		a.logo(href='#home' aria-label=T.logoHome)
			span.logo__icon
				+logo
			span.logo__text
				span.logo__name DOMAIN
				span.logo__sub= T.premium
		nav.nav(data-nav aria-label=T.nav.aria)
			a.nav__link.is-active(href='#home')= T.nav.home
			a.nav__link(href='#technology')= T.nav.technology
			a.nav__link(href='#coverage')= T.nav.coverage
			a.nav__link(href='#plans')= T.nav.plans
			a.nav__link(href='#about')= T.nav.about
			span.nav__indicator(data-nav-indicator)
		//- выбор языка
		.lang(data-lang)
			button.lang__btn(type='button' aria-expanded='false' aria-controls='lang-list' aria-label=T.lang + ': ' + LANGS[LANG].name data-lang-btn)
				+icon('globe')
				span= LANGS[LANG].code
				span.lang__caret(aria-hidden='true')
			ul.lang__list#lang-list(data-lang-list)
				+langLinks('lang__opt')
		a.btn-account(href='#' data-magnetic)
			+icon('user')
			span= T.nav.account
		button.burger(type='button' data-burger aria-label=T.nav.open aria-expanded='false' aria-controls='menu')
			span
			span

.menu#menu(data-menu role='dialog' aria-modal='true' aria-label=T.nav.menu)
	nav.menu__nav(aria-label=T.nav.ariaMobile)
		a.menu__link(href='#home')
			span.menu__num 01
			= T.nav.home
		a.menu__link(href='#technology')
			span.menu__num 02
			= T.nav.technology
		a.menu__link(href='#coverage')
			span.menu__num 03
			= T.nav.coverage
		a.menu__link(href='#plans')
			span.menu__num 04
			= T.nav.plans
		a.menu__link(href='#about')
			span.menu__num 05
			= T.nav.about
	ul.menu__langs(aria-label=T.lang)
		+langLinks('menu__lang')
	a.btn.btn--ghost.menu__account(href='#')
		+icon('user')
		span= T.nav.account
